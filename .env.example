# Copy to .env and fill in. .env is never committed.

# Channex connectivity provider (https://channex.io). Leave the key empty to run with demo OTAs only.
CHANNEX_API_KEY=
# staging (free sandbox, staging.channex.io) or production (app.channex.io)
CHANNEX_ENV=staging
# Shared secret Channex sends in the X-Channex-Webhook-Secret header. Needed only if you set up the webhook.
CHANNEX_WEBHOOK_SECRET=
# How often to check Channex for new bookings, in seconds.
CHANNEX_POLL_SECONDS=60

# PORT=3000
# DB_FILE=./data/channel-manager.db
